{
  "name": "ktype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Korean typing trainer that visualizes how jamo assemble into syllable blocks",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "vite": "^6.0.0"
  },
  "license": "MIT",
  "homepage": "https://workmate.tools/ktype/?ui=en&target=ko",
  "keywords": [
    "hangul",
    "korean",
    "typing",
    "ime",
    "dubeolsik",
    "cheonjiin",
    "learning"
  ]
}
